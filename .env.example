# =============================================================================
# web_reverse_lab 的运行期变量。复制成 .env 后按需修改：
#     Copy-Item .env.example .env
# 这个文件里的每一项都对应架构里的一个边界，不是"可选调参"。
# =============================================================================

# --- 镜像 -------------------------------------------------------------------
# mitmproxy 的 tag。由 scripts/pull_through.ps1 决定实际落地的是哪个 tag
# （先试 11.1.0，失败降级 11.0.2，再降级 latest），成功后写入 images.lock。
MITM_TAG=11.1.0
# 靶场镜像 tag
RANGE_TAG=latest
# 爬虫镜像 tag（projectdiscovery/katana）
KATANA_TAG=latest

# --- 证据 -------------------------------------------------------------------
# 一次运行的标识。留空 = 由 addon 用启动时刻生成（20261107T142100 形式）。
# 显式指定时，同名旧证据会被**改名保留**为 <RUN_ID>.prev-<时间>.jsonl：
# addon 是逐行追加写的，若直接续写会让 seq 从 0 重来、与旧行撞号，
# 回链锚点 flows#seq-N 就失效了；改名既保住旧证据，也保住锚点的唯一性。
RUN_ID=

# --- 出口白名单（真正的边界） ------------------------------------------------
# mitmproxy 的 --allow-hosts 正则：代理**只允许**连这些上游。
# 这是本工程里唯一一处能在"容器已经接通网络"的前提下限制去向的机制——
# 因为目标在宿主机上，容器必须能到 host-gateway，network=internal 那套
# "物理上没有网卡"的证明在此不成立，只能用白名单替代，且白名单本身要可复核。
#
# 反斜杠是正则转义，不是路径分隔符，别删。
ALLOW_HOSTS=^(host\.docker\.internal|127\.0\.0\.1|localhost|range|juice-shop|dvwa|webgoat)(:[0-9]+)?

# --- 目标别名（宿主机回环 → 容器可达地址） -----------------------------------
# 宿主机浏览器把 Host 写成 127.0.0.1:3000，但容器里的 127.0.0.1 是它自己。
# 这条映射把"发往宿主回环的请求"改投到 host.docker.internal，Host 头保持原样。
#
# 格式：<原始 host:port>=<实际 host:port>[,<第二组>...]
# 用你自己起的靶场时按实际端口追加，例如 range 服务发布在 127.0.0.1:3001：
#   127.0.0.1:3000=host.docker.internal:3000,127.0.0.1:3001=host.docker.internal:3001
TARGET_HOST_ALIAS=127.0.0.1:3000=host.docker.internal:3000

# --- 宿主机浏览器代理端口 ----------------------------------------------------
# 只绑回环，局域网看不见。改这里要同步改 compose 的 ports 与 README 的说明。
MITM_PORT=8080

# --- L2 爬虫（katana） --------------------------------------------------------
# CRAWL_URL 是**容器内**视角的目标地址：爬虫在 compose 网络里，宿主机回环对它
# 不可见，所以用 host.docker.internal。这也是 allow_hosts 里必须放行它的原因。
CRAWL_URL=http://host.docker.internal:3000
CRAWL_PROXY=http://mitmproxy:8080
CRAWL_DEPTH=3
CRAWL_CONCURRENCY=3
# 作用域：dn = 主机名本身。别用 rdn —— host.docker.internal 的"注册域"比它宽，
# 实测会把 main.js 里引用的站外链接（owasp.org / opensea）也当成本目标。
CRAWL_SCOPE=dn
# 单用户靶场，宁可慢。10 rps 已经比人手快两个数量级。
CRAWL_RATE_LIMIT=10
